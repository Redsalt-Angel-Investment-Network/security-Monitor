# Easiest: run `python scripts/setup.py`, which writes .env for you with fresh
# random keys. This file documents every setting. NEVER commit the real .env.

# --- Keys (the collector refuses to start with placeholders or keys < 24 chars)
# One key per source, name=key, comma-separated. Revoke a source by deleting it.
SM_API_KEYS=webcheck=change-me,agents=change-me
SM_WEBCHECK_KEY=change-me          # the web checker's key (docker-compose uses it)
SM_API_KEY=change-me               # key used by agents run from this machine

# --- What to watch (only sites you own or may test)
SM_CHECK_URLS=https://app.example.com,https://api.example.com
SM_CHECK_DOMAINS=                  # blank = derived from the URLs

# --- Alerts: instant at/above this severity, everything else in the digest
SM_INSTANT_MIN_SEVERITY=high       # low | medium | high | critical
SM_DIGEST_HOUR_UTC=7               # blank = no scheduled digest
SM_ALERT_COOLDOWN_MINUTES=30
SM_SLACK_WEBHOOK_URL=
SM_SMTP_HOST=
SM_SMTP_PORT=587
SM_SMTP_USER=
SM_SMTP_PASSWORD=
SM_EMAIL_FROM=
SM_EMAIL_TO=

# --- Storage / agents
SM_DB_PATH=
SM_COLLECTOR_URL=http://127.0.0.1:8000
SM_AGENT_ID=
